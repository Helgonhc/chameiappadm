# PRECIM — Variáveis de Ambiente Exemplo (Zero Secrets em Repositório)

# Supabase Public Specs
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (Apenas Server-Side, nunca expor no cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Redes Sociais da Operação (Opcional - Se não configurado, botões não aparecem)
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_WHATSAPP_URL=

# Configurações de Domínio da Aplicação
NEXT_PUBLIC_SITE_URL=http://localhost:3000
